{
    "name": "@qboapi/qbo-mcp-server",
    "version": "0.0.1",
    "description": "MCP server implementation for QuickBooks Online integration",
    "license": "MIT",
    "main": "dist/index.js",
    "type": "module",
    "bin": "./dist/index.js",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc && shx cp src/reports/report-schemas.json dist/reports/report-schemas.json && shx chmod +x dist/*.js",
        "watch": "tsc --watch",
        "knip": "knip",
        "auth": "node dist/auth-server.js"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.6.0",
        "dotenv": "^16.4.7",
        "intuit-oauth": "^4.0.0",
        "node-quickbooks": "^2.0.43",
        "open": "^9.1.0",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "knip": "^6.3.0",
        "shx": "^0.3.4",
        "typescript": "^5.8.2"
    }
}